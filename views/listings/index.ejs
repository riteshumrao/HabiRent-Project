<% layout("/layouts/boilerplate") %>


<div id="filters">
  
  <div class="filter-bar">
    <a href="/listings">
      <div class="filter <% if (!currentCategory) { %>active<% } %>">
        <div><i class="fa-solid fa-list-ul"></i></div>
        <p>Show All</p>
      </div>
    </a>

    <a href="/listings?category=Trending">
      <div class="filter <% if (currentCategory === 'Trending') { %>active<% } %>">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
      </div>
    </a>

    <a href="/listings?category=Rooms">
      <div class="filter <% if (currentCategory === 'Rooms') { %>active<% } %>">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
      </div>
    </a>

    <a href="/listings?category=Iconic Cities">
      <div class="filter <% if (currentCategory === 'Iconic Cities') { %>active<% } %>">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
      </div>
    </a>

    <a href="/listings?category=Mountains">
      <div class="filter <% if (currentCategory === 'Mountains') { %>active<% } %>">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
      </div>
    </a>

    <a href="/listings?category=Castles">
      <div class="filter <% if (currentCategory === 'Castles') { %>active<% } %>">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
      </div>
    </a>

    <a href="/listings?category=Amazing Pools">
      <div class="filter <% if (currentCategory === 'Amazing Pools') { %>active<% } %>">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
      </div>
    </a>

    <a href="/listings?category=Camping">
      <div class="filter <% if (currentCategory === 'Camping') { %>active<% } %>">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
      </div>
    </a>

    <a href="/listings?category=Farms">
      <div class="filter <% if (currentCategory === 'Farms') { %>active<% } %>">
        <div><i class="fa-solid fa-tractor"></i></div>
        <p>Farms</p>
      </div>
    </a>

    <a href="/listings?category=Arctic">
      <div class="filter <% if (currentCategory === 'Arctic') { %>active<% } %>">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
      </div>
    </a>
    <a href="/listings?category=Domes">
      <div class="filter <% if (currentCategory === 'Domes') { %>active<% } %>">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
      </div>
    </a>

    <a href="/listings?category=Boats">
      <div class="filter <% if (currentCategory === 'Boats') { %>active<% } %>">
        <div><i class="fa-solid fa-sailboat"></i></div>
        <p>Boats</p>
      </div>
    </a>
  </div>


 
  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="switchCheckDefault"
      />
      <label class="form-check-label" for="switchCheckDefault"
        >Display total after Taxes</label
      >
    </div>
  </div>
</div>


<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for(let listing of allListings){ %>
  <a href="/listings/<%= listing._id %>" class="listing-link">
    <div class="card col listing-card">
      <img
        src="<%= listing.image.url %>"
        class="card-img-top"
        alt="listing_image"
        style="height: 20rem"
      />
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-title">
          <b><%= listing.title %></b>
          <br />
          &#8377;<%= listing.price.toLocaleString('en-IN') %> / night
          <i class="tax-info">&nbsp;+18% GST</i>
        </p>
      </div>
    </div>
  </a>
  <% } %>
</div>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for (info of taxInfo) {
      if (info.style.display != "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>