<style>
  .search-btn{
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
  };

  .search-btn:hover{
    background-color: #fe424d;
    color: #fff;
  };

  .search-btn i {

    display: inline;

    margin-right: 0.5rem;

  }

  .search-inp{
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
    font-size: 1rem;
  };

  .signup-btn{
  opacity: 0.8;
};

.login-btn{
opacity: 0.8;
};

.signup-btn:hover{
opacity: 1;
};

.login-btn:hover{
opacity: 1;
};

</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"
      ><i class="fa-regular fa-compass"></i
    ></a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    
    <div
      class="collapse navbar-collapse"
      id="navbarNavAltMarkup"
      style="
        z-index: 1000;
        position: relative;
        background-color: white;
      "
    >
      <div class="navbar-nav">
        <a class="nav-link d-none d-md-block" href="/listings">Explore</a>
      </div>
      <div class="navbar-nav ms-auto">
          <form class="d-flex" action="/listings" method="GET" role="search">
            <input
              class="form-control me-2 search-inp"
              type="search"
              placeholder="Search destinations"
              aria-label="Search"
              name="search"
              value="<%= searchQuery %>"
            />
            <button class="btn search-btn" type="submit" style="background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;">
              <div style="display: flex ; align-items: center; justify-content: space-evenly;"><i class="fa-solid fa-magnifying-glass"></i>Search</div>
            </button>

          </form>

      </div>

      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">HabiRent your home</a>
        <% if(!currUser) { %>
        <a class="nav-link signup-btn" href="/signup"><b>Signup</b></a>
        <a class="nav-link login-btn" href="/login"><b>Login</b></a>
        <% } %> <% if(currUser) { %>
        <a class="nav-link" href="/logout"><b>Logout</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>